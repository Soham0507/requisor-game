{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build:web",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "artifacts/citrus-landing/dist/public",
  "framework": null,
  "github": { "silent": true },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-ME.up.railway.app/api/:path*"
    },
    {
      "source": "/game-previews/boat-booth/:path*",
      "destination": "/game-previews/boat-booth/index.html"
    },
    {
      "source": "/((?!api/|game-previews/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/game-previews/:slug/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*.(mp4|webm|woff|woff2|png|jpg|jpeg|svg|glb|gltf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
